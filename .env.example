# PUSD_CONTRACTS — deploy-time env (copy to .env)
# Consumed by scripts/deploy_*.sh and the soroban CLI. Contract IDs are NOT
# stored here — they are written to deployments/*.json by the deploy scripts
# and read by the backend from PUSD_BACKEND/.env (which is present).

# Pi Testnet Soroban RPC
PI_SOROBAN_RPC_URL=https://rpc.testnet.minepi.com
# Pi Testnet network passphrase
PI_TESTNET_PASSPHRASE=Pi Testnet
# Optional alias
PI_NETWORK_PASSPHRASE=Pi Testnet

# Admin/issuer keypair used to deploy + initialize contracts.
# RECOVER from pusd/PUSD_BACKEND/.env (same ISSUER_SECRET_KEY / admin seed) —
# it is already present there. Only generate a NEW keypair if you intentionally
# redeploy all contracts from scratch (see REMEDIATION_PLAN.md rotation caveat).
ADMIN_SECRET_KEY=
